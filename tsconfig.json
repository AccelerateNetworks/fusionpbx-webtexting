{
  "include": [
    "frontend/*",
    "frontend/**/*",
    "node_modules/sip.js/src/**/*"
  ],
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./frontend/*"
      ],
      // A new catch-all that replaces the baseUrl:
      "*": ["./frontend/*"],

      // Every other path now has an explicit common prefix:
      "@app/*": ["./src/app/*"],
      "@lib/*": ["./src/lib/*"],
    },
    "lib": [
      "es2017",
      "DOM",
      "DOM.Iterable"
    ],
    "sourceMap": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
  },
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
