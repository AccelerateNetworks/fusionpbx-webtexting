<?xml version="1.0" encoding="utf-8"?>
<include>
        <context name="public">
        <!-- Inbound delivery from carrier: PHP sets inbound=true (Patch 5) -->
        <extension name="inbound_messaging">
                <condition field="inbound" expression="^true$"/>
                <condition field="to_user" expression="^\d{1,5}$" break="on-true">
                        <action application="set" data="sip_profile=internal-5065-5066" inline="true"/>
                        <action application="info" data="DEBUG" inline="true"/>
                        <action application="send" data="sip" inline="true"/>
                </condition>
        </extension>

        <!-- All outbound: PSTN, short extensions, short codes -->
        <extension name="outbound">
                <condition field="to" expression="^(.+)$">
                        <action application="set" data="extension_uuid=${user_data(${from_user}@${from_host} var extension_uuid)}" inline="true"/>
                        <action application="set" data="final_delivery=true" inline="true"/>
                        <action application="lua" data="app.lua webtexting outbound" inline="true"/>
                </condition>
        </extension>
        </context>
</include>